{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GdeltArticleCollection",
  "description": "Output schema for GDELT UAP/UFO news articles fetched by scripts/gdelt/fetch.mjs",
  "type": "object",
  "required": ["generatedAt", "query", "articles"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when this file was generated"
    },
    "query": {
      "type": "string",
      "description": "The GDELT query string used to fetch articles"
    },
    "totalResults": {
      "type": "integer",
      "description": "Total number of articles returned before deduplication"
    },
    "articles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GdeltArticle"
      }
    }
  },
  "definitions": {
    "GdeltArticle": {
      "type": "object",
      "required": ["id", "title", "url", "domain", "publishedAt", "language"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID derived from URL hash"
        },
        "title": {
          "type": "string",
          "description": "Article headline"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Original article URL"
        },
        "domain": {
          "type": "string",
          "description": "Source domain (e.g. bbc.co.uk)"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Publication date in ISO 8601"
        },
        "language": {
          "type": "string",
          "description": "ISO 639-1 language code"
        },
        "sourceName": {
          "type": "string",
          "description": "Human-readable source name if available"
        },
        "country": {
          "type": "string",
          "description": "Country of origin (2-letter ISO code)"
        },
        "imageUrl": {
          "type": ["string", "null"],
          "description": "Social sharing image URL"
        },
        "tone": {
          "type": "number",
          "description": "GDELT tone score (-100 to +100, negative = negative tone)"
        }
      }
    }
  }
}
