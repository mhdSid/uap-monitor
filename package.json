{
  "name": "uap-monitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/chunk-public-data.mjs --dir public/data --limit 24 && vite build",
    "chunk": "node scripts/chunk-public-data.mjs --dir public/data --limit 24",
    "cf:deploy": "yarn build && wrangler pages deploy dist",
    "dev": "vite --host",
    "eslint": "eslint . --ext .ts,.js,.mjs",
    "fetch:fireball": "node scripts/nasa-fireball/fetch.mjs --out public/data/nasa-fireballs.json",
    "fetch:gdelt": "node scripts/gdelt/fetch.mjs --out public/data/gdelt-articles.json --days 90 --max 1250",
    "fetch:geomagnetic": "node scripts/geomagnetic/fetch.mjs --out public/data/geomagnetic-kp.json",
    "fetch:seismic": "node scripts/seismic/fetch.mjs --out-dir public/data/earthquakes --manifest public/data/earthquakes-manifest.json --start 1970 --min-mag 4.0",
    "fetch:gnews": "node scripts/gnews/fetch.mjs --out public/data/gnews-articles.json --days 730 --limit 500",
    "fetch:reddit": "node scripts/reddit/fetch.mjs --out public/data/reddit-articles.json",
    "fetch:twitter": "node scripts/twitter/fetch.mjs --out public/data/twitter-articles.json --limit 10000 --pages 10000",
    "fetch:nuclear": "node scripts/nuclear/fetch.mjs --out public/data/nuclear-facilities.json",
    "fetch:all": "yarn fetch:nuclear && yarn fetch:fireball && yarn fetch:geomagnetic && yarn fetch:seismic && yarn fetch:gdelt && yarn fetch:gnews && yarn fetch:reddit && yarn fetch:twitter && yarn scrape:nuforc:2026:2026 && yarn scrape:nuforc:cache:huggingface && yarn process:data:pipeline:all",
    "preview": "vite preview",
    "process:data:pipeline:all": "yarn process:data:pipeline:nuforc && yarn process:data:pipeline:hatch && yarn process:data:pipeline:chronology && yarn process:data:pipeline:russian",
    "process:data:pipeline:chronology": "node scripts/process-chronology.mjs",
    "process:data:pipeline:hatch": "node scripts/process-hatch.mjs",
    "process:data:pipeline:nuforc": "node scripts/process-nuforc.mjs",
    "process:data:pipeline:russian": "node scripts/process-russian-historical.mjs",
    "sanitize:nuforc": "node scripts/nuforc-scrapper/sanitize.mjs __sources/nuforc.json --fields text,Text,summary,description",
    "scrape:nuforc:2024": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 195787 --concurrency 3 --delay 300 --years 2024",
    "scrape:nuforc:2025": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 195122 --concurrency 1 --years 2025",
    "scrape:nuforc:2026:2026": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 196499 --concurrency 1 --years 2026-2026",
    "scrape:nuforc:cache:full": "node scripts/nuforc-scrapper/scraper.mjs --cache --schema scripts/nuforc-scrapper/schemas/full.json",
    "scrape:nuforc:cache:huggingface": "node scripts/nuforc-scrapper/scraper.mjs --cache --schema scripts/nuforc-scrapper/schemas/huggingface.json --output nuforc_scraped.json --merge __sources/nuforc.json",
    "scrape:nuforc:cache:minimal": "node scripts/nuforc-scrapper/scraper.mjs --cache --schema scripts/nuforc-scrapper/schemas/minimal.json",
    "scrape:nuforc:test-transforms": "node scripts/nuforc-scrapper/test-transforms.mjs",
    "scrape:nuforc:test:tor": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 196128 --years 2026 --limit 5 --verbose --tor",
    "scrape:nuforc:test": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 196128 --years 2026 --limit 5 --verbose",
    "scrape:nuforc": "node scripts/nuforc-scrapper/scraper.mjs --resume --concurrency 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gnews-io/gnews-io-js": "^2.2.0",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-basic-ssl": "^2.2.0",
    "all-the-cities": "^3.1.0",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "eslint": "^10.0.2",
    "gdelt-ts-client": "^1.2.4",
    "node-fetch": "^3.3.2",
    "socks-proxy-agent": "^8.0.5",
    "twitter-api-v2": "^1.29.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  }
}
