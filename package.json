{
  "name": "uap-monitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "eslint": "eslint . --ext .ts,.js,.mjs",
    "preview": "vite preview",
    "data:nuforc": "node scripts/process-nuforc.mjs",
    "data:hatch": "node scripts/process-hatch.mjs",
    "data:chronology": "node scripts/process-chronology.mjs",
    "data:pipeline:all": "yarn data:nuforc && yarn data:hatch && yarn data:chronology",
    "scrape:nuforc:2026": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 196128 --concurrency 1 --years 2026",
    "scrape:nuforc:2025": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 196128 --concurrency 1 --years 2025",
    "scrape:nuforc:2024": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 196128 --concurrency 1 --years 2024",
    "scrape:nuforc:test": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 196128 --years 2026 --limit 5 --verbose",
    "scrape:nuforc:test:tor": "node scripts/nuforc-scrapper/scraper.mjs --resume --start-id 196128 --years 2026 --limit 5 --verbose --tor",
    "scrape:nuforc:test-transforms": "node scripts/nuforc-scrapper/test-transforms.mjs",
    "scrape:nuforc:cache:huggingface": "node scripts/nuforc-scrapper/scraper.mjs --cache --schema scripts/nuforc-scrapper/schemas/huggingface.json --output nuforc_scraped.json --merge __sources/nuforc.json",
    "scrape:nuforc:cache:full": "node scripts/nuforc-scrapper/scraper.mjs --cache --schema scripts/nuforc-scrapper/schemas/full.json",
    "scrape:nuforc:cache:minimal": "node scripts/nuforc-scrapper/scraper.mjs --cache --schema scripts/nuforc-scrapper/schemas/minimal.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.21",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "eslint": "^10.0.2",
    "node-fetch": "^3.3.2",
    "socks-proxy-agent": "^8.0.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  }
}
